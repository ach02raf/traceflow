@{ ViewData["Title"] = "Welcome"; }

<section class="hero text-center">
  <span class="badge rounded-pill text-bg-primary mb-3"><i class="bi bi-lightning-charge-fill"></i> Real-time · SignalR</span>
  <h1 class="display-5 fw-semibold mb-3">Production traceability, <span class="grad">live</span>.</h1>
  <p class="lead text-secondary mx-auto" style="max-width:620px">
    Track every unit from Assembly to Shipped. Every operator sees every change instantly.
  </p>

  @if (TempData["Error"] is string err)
  {
    <div class="alert alert-warning d-inline-block">@err</div>
  }

  <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
    <form method="post" asp-controller="Guest" asp-action="Start">
      <button class="btn btn-primary btn-lg px-4"><i class="bi bi-person-plus-fill"></i> Continue as guest</button>
    </form>
    <a class="btn btn-outline-light btn-lg px-4" asp-area="Identity" asp-page="/Account/Login">
      <i class="bi bi-box-arrow-in-right"></i> Login
    </a>
  </div>
  <p class="small text-secondary mt-3 mb-0">
    <i class="bi bi-info-circle"></i> A guest account is temporary: it is deleted automatically when you leave.
  </p>
</section>

<div class="row g-3 mt-4">
  <div class="col-md-4"><div class="feature"><i class="bi bi-broadcast"></i><h5>Live sync</h5>
    <p>SignalR pushes every move to all connected users in milliseconds.</p></div></div>
  <div class="col-md-4"><div class="feature"><i class="bi bi-shield-lock"></i><h5>Roles &amp; security</h5>
    <p>Operators move units, supervisors flag defects. Enforced on the server.</p></div></div>
  <div class="col-md-4"><div class="feature"><i class="bi bi-clock-history"></i><h5>Full history</h5>
    <p>Every action is stored: who, what, when. Built for compliance.</p></div></div>
</div>

<div class="feature mt-3">
  <h6 class="mb-2"><i class="bi bi-key"></i> Demo accounts</h6>
  <div class="small text-secondary">
    <code>operator@demo.com</code> (Operator) · <code>supervisor@demo.com</code> (Supervisor) · password <code>Demo123!</code>
  </div>
</div>
